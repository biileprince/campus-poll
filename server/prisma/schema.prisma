// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String
  role        String   @default("user") // user, admin
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  polls       Poll[]   // One user can create many polls

  @@map("users")
}

model Poll {
  id          String   @id @default(cuid())
  question    String
  voteId      String   @unique @default(cuid()) // Unique ID for voting link
  resultsId   String   @unique @default(cuid()) // Unique ID for results link
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?  // User ID who created this poll
  user        User?    @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  options     Option[]

  @@map("polls")
}

model Option {
  id        String   @id @default(cuid())
  text      String
  voteCount Int      @default(0)
  pollId    String
  poll      Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("options")
}
